Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Name: root
  Global Options:
    Background Color: 28; 28; 36
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 17
      Plane Cell Count: 52
      Color: 70; 70; 85
      Line Style:
        Value: Lines
      Reference Frame: map
    - Class: rviz_default_plugins/Map
      Name: Obstacles
      Enabled: true
      Topic:
        Value: /rf_map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.9
      Draw Behind: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Reconstruction Overlay
      Enabled: true
      Topic:
        Value: /rf_recon_cloud
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Style: Flat Squares
      Size (m): 3.4
      Color Transformer: RGB8
      Decay Time: 0
      Selectable: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Marker Scale: 20
    - Class: rviz_default_plugins/Marker
      Name: Path
      Enabled: true
      Topic:
        Value: /rf_path
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Markers
      Enabled: true
      Topic:
        Value: /rf_markers
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Image
      Name: Reconstruction
      Enabled: true
      Topic:
        Value: /rf_recon
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 560
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.55
      Yaw: 0.9
      Target Frame: map
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Views:
    collapsed: false
  Height: 820
  Width: 1280
  Reconstruction:
    collapsed: false
