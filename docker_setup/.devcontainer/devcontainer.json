{
  "name": "Spectrum Cartography — ROS 2 Humble + Gazebo Harmonic",
  "build": {
    "dockerfile": "../Dockerfile",
    "args": {
      "USERNAME": "ros",
      "USER_UID": "1000"
    }
  },
  "remoteUser": "ros",
  // Mount your folder at ~/host. Mounting it over ~/ros2_ws (the original setting)
  // hides the ArduPilot/ROS workspace that the image spent an hour building.
  "workspaceFolder": "/home/ros/host",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/ros/host,type=bind",
  "runArgs": [
    "--platform=linux/amd64",
    "--net=host",
    "--ipc=host",
    "-e", "DISPLAY=host.docker.internal:0",
    "-e", "LIBGL_ALWAYS_SOFTWARE=1",
    "-e", "MESA_GL_VERSION_OVERRIDE=3.3",
    "-e", "MESA_LOADER_DRIVER_OVERRIDE=softpipe",
    "-e", "EGL_PLATFORM=surfaceless"
  ],
  "containerEnv": {
    "ROS_DOMAIN_ID": "42",
    "GZ_VERSION": "harmonic"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros",
        "ms-vscode.cpptools",
        "twxs.cmake",
        "ms-python.python"
      ]
    }
  },
  "postCreateCommand": "cp ~/host/launch_sim.sh ~/launch_sim.sh && echo 'Dev container ready. Run: bash ~/launch_sim.sh'"
}
